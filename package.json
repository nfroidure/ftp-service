{
  "metapak": {
    "data": {
      "files": "'src/**/*.ts'",
      "testsFiles": "'src/**/*.test.ts'",
      "distFiles": "'dist/**/*.js'",
      "ignore": [
        "dist"
      ],
      "bundleFiles": [
        "dist/**/*.js",
        "dist/index.d.ts",
        "dist",
        "src"
      ]
    },
    "configs": [
      "main",
      "readme",
      "eslint",
      "tsesm",
      "jest",
      "jsdocs",
      "jsarch",
      "codeclimate"
    ]
  },
  "name": "ftp-service",
  "version": "8.0.2",
  "type": "module",
  "description": "A simple wrapper for a simpler FTP client surface API with pool and retry management.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "architecture": "jsarch 'src/**/*.ts' > ARCHITECTURE.md && git add ARCHITECTURE.md",
    "build": "rimraf 'dist' && tsc --outDir dist",
    "changelog": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -s && git add CHANGELOG.md",
    "cli": "env NODE_ENV=${NODE_ENV:-cli}",
    "commitlint": "commitlint",
    "cover": "node --run jest -- --coverage",
    "doc": "echo \"# API\" > API.md; jsdoc2md 'dist/**/*.js' >> API.md && git add API.md",
    "format": "node --run prettier",
    "jest": "NODE_OPTIONS=--experimental-vm-modules NODE_ENV=test jest",
    "lint": "eslint 'src/**/*.ts'",
    "metapak": "metapak",
    "precommit": "node --run test && node --run lint && node --run metapak -- -s && node --run build && node --run doc && node --run architecture",
    "prettier": "prettier --write 'src/**/*.ts'",
    "preversion": "node --run build && node --run test && node --run lint && node --run architecture && node --run doc && node --run metapak -- -s",
    "rebuild": "swc ./src -s -d dist -C jsc.target=es2022",
    "test": "node --run jest",
    "version": "node --run changelog"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nfroidure/ftp-service.git"
  },
  "keywords": [
    "ftp",
    "knifecycle"
  ],
  "author": {
    "name": "Nicolas Froidure",
    "email": "nicolas.froidure@insertafter.com",
    "url": "https://insertafter.com/en/index.html"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nfroidure/ftp-service/issues"
  },
  "homepage": "https://github.com/nfroidure/ftp-service#readme",
  "dependencies": {
    "basic-ftp": "^6.2.6",
    "common-services": "^20.1.0",
    "generic-pool": "^3.9.0",
    "knifecycle": "^21.4.0",
    "yerror": "^11.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "conventional-changelog": "8.1.3",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.5.1",
    "jsarch": "^7.1.2",
    "jsdoc-to-markdown": "^9.1.3",
    "metapak": "^7.1.1",
    "metapak-nfroidure": "22.2.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "contributors": [],
  "engines": {
    "node": ">=24.14.0"
  },
  "jest": {
    "coverageReporters": [
      "lcov"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "roots": [
      "<rootDir>/src"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "@swc/jest",
        {}
      ]
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
      "(.+)\\.js": "$1"
    },
    "extensionsToTreatAsEsm": [
      ".ts"
    ]
  },
  "files": [
    "dist/**/*.js",
    "dist/index.d.ts",
    "dist",
    "src",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "prettier": {
    "semi": true,
    "printWidth": 80,
    "singleQuote": true,
    "trailingComma": "all",
    "proseWrap": "always"
  },
  "jsarch": {
    "parserOptions": {
      "plugins": [
        "typescript"
      ]
    }
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/nfroidure"
  }
}